# Conexão direta (porta 5432), role credx7i_owner. Usada por: migrations e suíte de isolamento.
# Supabase: Project Settings > Database > Connection string > Direct
DATABASE_URL=postgresql://credx7i_owner:SENHA@db.yjpinvutihkykcckbdet.supabase.co:5432/postgres

# Conexão via pooler (porta 6543, modo transaction), role credx7i_app (sem BYPASSRLS).
# Usada por: o servidor em runtime.
# Supabase: Project Settings > Database > Connection string > Transaction pooler
DATABASE_POOLER_URL=postgresql://credx7i_app:SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Opcional: conexão direta (5432) com o role credx7i_app. Usada só pela suíte de isolamento
# para fazer as asserções com o mesmo role do runtime, sem passar pelo pooler.
# Sem esta variável, a suíte cai no DATABASE_POOLER_URL.
DATABASE_APP_URL=postgresql://credx7i_app:SENHA@db.yjpinvutihkykcckbdet.supabase.co:5432/postgres

PORT=3101
CORS_ORIGINS=http://localhost:5183
TENANT_BASE_DOMAIN=credx7i.local
