# Copiar para .env e preencher. O .env fica fora do git.
#
# IMPORTANTE: nos projetos novos do Supabase o host direto (db.<ref>.supabase.co) é
# IPv6-only. Se a sua rede não tem IPv6, TUDO passa pelo pooler (IPv4):
#   - session mode  (porta 5432) para migrations e para a suíte de isolamento
#   - transaction mode (porta 6543) para o runtime do servidor
# No pooler o usuário leva o ref do projeto grudado: credx7i_app.<ref>

# migrations - role credx7i_owner, session pooler (5432)
DATABASE_URL=postgresql://credx7i_owner.SEU_REF:SENHA_OWNER@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# runtime do servidor - role credx7i_app, transaction pooler (6543)
DATABASE_POOLER_URL=postgresql://credx7i_app.SEU_REF:SENHA_APP@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# suíte de isolamento - role credx7i_app, session pooler (5432)
DATABASE_APP_URL=postgresql://credx7i_app.SEU_REF:SENHA_APP@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

PORT=3101
CORS_ORIGINS=http://localhost:5183
TENANT_BASE_DOMAIN=credx7i.local
